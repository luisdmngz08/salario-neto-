
def promedio():
    print("Media de números positivos")

    suma = 0
    contador = 0

    while True:
        numero = float(input("Ingresa un número (negativo para terminar): "))

        if numero < 0:
            break

        suma += numero
        contador += 1

    if contador > 0:
        print(f"Promedio: {suma/contador:.2f}")
    else:
        print("No se ingresaron números positivos.")

promedio()
