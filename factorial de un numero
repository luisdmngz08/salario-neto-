
def calcular_factorial():
    print("Factorial de un número")

    try:
        numero = int(input("Ingresa un número entero: "))

        factorial = 1

        for i in range(1, numero + 1):
            factorial *= i

        print("\nResultados:")
        print(f"El factorial de {numero} es {factorial}")

    except ValueError:
        print("Error: Ingresa un número entero.")

calcular_factorial()
